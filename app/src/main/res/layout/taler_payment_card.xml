<?xml version="1.0" encoding="utf-8"?><!--
  ~ GNU-Fork (Signal-Taler-Integration), siehe docs/API.md.
  ~ Neues Design nach taler-kachel-preview.html (Meilenstein 7+)
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/rounded_rectangle_surface_variant_18"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="11dp">

    <!-- Brand-Row: Logo + Kind-Text + optional Preview-Badge -->
    <LinearLayout
        android:id="@+id/taler_card_brand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <!-- Taler Brand Logo (SVG) -->
        <ImageView
            android:id="@+id/taler_card_logo"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/ic_taler_brand"
            android:contentDescription="@null" />

        <!-- Kind label (e.g., "Zahlungslink", "Zahlungsanfrage") -->
        <TextView
            android:id="@+id/taler_card_kind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:textAppearance="@style/Signal.Text.Caption"
            android:textStyle="bold"
            android:textColor="@color/signal_text_secondary"
            android:letterSpacing="0.02"
            tools:text="Zahlungslink" />

        <!-- Preview Badge for Split (optional) -->
        <TextView
            android:id="@+id/taler_card_preview_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/taler_chip_split_preview"
            android:textAppearance="@style/Signal.Text.Caption"
            android:textStyle="bold"
            android:textColor="@color/taler_split_preview_text"
            android:textSize="9.5sp"
            android:letterSpacing="0.02"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:visibility="gone"
            tools:text="Vorschau: Split"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Amount Row: Direction arrow + Amount + Currency symbol -->
    <LinearLayout
        android:id="@+id/taler_card_amount_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <!-- Direction arrow -->
        <TextView
            android:id="@+id/taler_card_direction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Signal.Text.TitleMedium"
            android:textStyle="bold"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            tools:text="↓" />

        <!-- Amount -->
        <TextView
            android:id="@+id/taler_card_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:textAppearance="@style/Signal.Text.TitleMedium"
            android:textStyle="bold"
            android:textSize="19sp"
            android:fontFamily="sans-serif"
            tools:text="5,00" />

        <!-- Currency symbol/badge -->
        <TextView
            android:id="@+id/taler_card_currency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Signal.Text.TitleMedium"
            android:textStyle="bold"
            android:textSize="19sp"
            android:fontFamily="sans-serif"
            tools:text="ク" />
    </LinearLayout>

    <!-- Party: "an dich" or "von dir" -->
    <TextView
        android:id="@+id/taler_card_party"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/Signal.Text.Caption"
        android:textColor="@color/signal_text_secondary"
        android:textSize="12sp"
        tools:text="an dich" />

    <!-- Split Note (optional) -->
    <TextView
        android:id="@+id/taler_card_split_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/Signal.Text.Caption"
        android:textColor="@color/signal_text_secondary"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="Gesamt 15,00 EUR \u00f7 3 Personen (inkl. dir) \u2022 2 Links verschickt"
        tools:visibility="visible" />

    <!-- Summary (optional) -->
    <TextView
        android:id="@+id/taler_card_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@style/Signal.Text.BodyMedium"
        android:textSize="12.5sp"
        android:visibility="gone"
        tools:text="Mittagessen"
        tools:visibility="visible" />

    <!-- Exchange Chip (optional) -->
    <LinearLayout
        android:id="@+id/taler_card_exchange_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/taler_chip_exchange"
        android:paddingStart="6dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/taler_card_exchange_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⇄"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/taler_card_exchange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textAppearance="@style/Signal.Text.Caption"
            android:textColor="@color/taler_exchange_chip_text"
            android:textSize="10.5sp"
            tools:text="exchange.demo.taler.net" />
    </LinearLayout>

    <!-- Status Container: either text with icon OR progress bar for split -->
    <LinearLayout
        android:id="@+id/taler_card_status_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="vertical">

        <!-- Status with icon (for non-split) -->
        <LinearLayout
            android:id="@+id/taler_card_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/taler_card_status_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Signal.Text.Caption"
                android:textStyle="bold"
                android:textSize="12sp"
                tools:text="✓" />

            <TextView
                android:id="@+id/taler_card_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textAppearance="@style/Signal.Text.Caption"
                android:textStyle="bold"
                android:textSize="12sp"
                tools:text="Bestätigt" />
        </LinearLayout>

        <!-- Split Progress Bar (alternative to status) -->
        <LinearLayout
            android:id="@+id/taler_card_split_progress_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Progress track -->
            <ProgressBar
                android:id="@+id/taler_card_split_progress_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginBottom="7dp"
                android:max="100"
                android:progress="50"
                android:indeterminate="false" />

            <!-- Progress text -->
            <TextView
                android:id="@+id/taler_card_split_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Signal.Text.Caption"
                android:textColor="@color/signal_text_secondary"
                android:textSize="11sp"
                tools:text="1 von 2 haben bezahlt" />
        </LinearLayout>
    </LinearLayout>

    <!-- Split Warning (optional) -->
    <TextView
        android:id="@+id/taler_card_split_warning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textAppearance="@style/Signal.Text.Caption"
        android:textStyle="bold"
        android:textSize="11sp"
        android:textColor="@color/taler_split_warning"
        android:visibility="gone"
        tools:text="⚠ Du hast das schon bezahlt — trotzdem nochmal möglich"
        tools:visibility="visible" />

    <!-- Actions Row -->
    <LinearLayout
        android:id="@+id/taler_card_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="9dp"
        android:visibility="gone">

        <!-- Alle anderen Aktionen (Ablehnen/Abbrechen/Aktualisieren/Rueckerstatten)
             leben jetzt im Long-Press-Menue statt hier auf der Karte, siehe
             TalerMenuState.kt/TalerMenuActions.kt. -->
        <Button
            android:id="@+id/taler_card_accept"
            style="@style/Widget.Signal.Button.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/TalerFork_action_accept" />

    </LinearLayout>

</LinearLayout>

